diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 5fef4c4..3685245 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1844,6 +1844,25 @@ ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
+    if (model.littlebit_version) {
+        const auto it = model.littlebit_projections.find(w);
+        if (it != model.littlebit_projections.end()) {
+            if (!loras->empty()) {
+                throw std::runtime_error("LoRA adapters are unsupported for LittleBit projections");
+            }
+            ggml_tensor * sum = nullptr;
+            for (const auto & branch : it->second) {
+                auto * x = ggml_mul(ctx0, cur, branch.input_scale);
+                auto * h = ggml_mul_mat(ctx0, branch.v, x);
+                h = ggml_mul(ctx0, h, branch.latent_scale);
+                auto * y = ggml_mul_mat(ctx0, branch.u, h);
+                y = ggml_mul(ctx0, y, branch.output_scale);
+                sum = sum ? ggml_add(ctx0, sum, y) : y;
+            }
+            return sum;
+        }
+    }
+
     if (!w_s) {
         w_s = model.get_w_scale(w);
     }
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index b204596..d32d797 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -4257,6 +4257,37 @@ llama_model_base::llama_model_base(const struct llama_model_params & params) : l
 
 ggml_tensor * llama_model_base::create_tensor(const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags) {
     GGML_ASSERT(ml != nullptr);
+    // In a LittleBit Qwen3 block, each required projection is stored as factors.
+    if (littlebit_version && tn.bid >= 0 && flags == 0 && ne.size() == 2 && std::string(tn.suffix) == "weight") {
+        const int64_t inputs = *ne.begin();
+        const int64_t outputs = *(ne.begin() + 1);
+        std::vector<littlebit_branch> branches;
+        for (int i = 0; i < (littlebit_residual ? 2 : 1); ++i) {
+            const std::string prefix = i ? "lb_r_" : "lb_";
+            auto name = [&](const char * field) { return prefix + field; };
+            auto field = [&](const char * key, std::initializer_list<int64_t> dims, ggml_type type) {
+                const auto suffix = name(key);
+                LLM_TN_IMPL n(tn.arch, tn.tensor, suffix.c_str(), tn.bid, tn.xid);
+                if (ml->require_tensor_meta(n.str())->type != type) {
+                    throw std::runtime_error("unexpected LittleBit tensor type: " + n.str());
+                }
+                return create_tensor(*ml, n, dims, 0);
+            };
+            const auto v_name = name("v");
+            LLM_TN_IMPL v(tn.arch, tn.tensor, v_name.c_str(), tn.bid, tn.xid);
+            const int64_t rank = ml->require_tensor_meta(v.str())->ne[1];
+            branches.push_back({
+                field("v", {inputs, rank}, GGML_TYPE_Q1_0),
+                field("u", {rank, outputs}, GGML_TYPE_Q1_0),
+                field("in", {inputs}, GGML_TYPE_F32),
+                field("mid", {rank}, GGML_TYPE_F32),
+                field("out", {outputs}, GGML_TYPE_F32),
+            });
+        }
+        auto * primary = branches.front().v;
+        littlebit_projections.emplace(primary, std::move(branches));
+        return primary;
+    }
     return create_tensor(*ml, tn, ne, flags);
 }
 
